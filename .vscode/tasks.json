{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Debug: Backend & Frontend",
      "dependsOn": [
        "Cleanup Port 5199",
        "Cleanup Port 5173",
        "Build Backend (Debug)",
        "Start Frontend Dev Server",
        "Open Frontend"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Cleanup Port 5199",
      "type": "shell",
      "command": "lsof -i :5199 2>/dev/null | grep LISTEN | awk '{print $2}' | xargs -I {} kill -9 {} 2>/dev/null; true",
      "problemMatcher": []
    },
    {
      "label": "Cleanup Port 5173",
      "type": "shell",
      "command": "lsof -i :5173 2>/dev/null | grep LISTEN | awk '{print $2}' | xargs -I {} kill -9 {} 2>/dev/null; true",
      "problemMatcher": []
    },
    {
      "label": "Build Backend (Debug)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/RemitMon.Api/RemitMon.Api.csproj",
        "--configuration",
        "Debug"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Start Frontend Dev Server",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*VITE.*ready.*$|^.*Local:.*$",
          "endsPattern": "^.*Local:.*http://localhost:5173.*$"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      }
    },
    {
      "label": "Open Frontend",
      "type": "process",
      "command": "open",
      "args": ["http://localhost:5173"],
      "problemMatcher": []
    },
    {
      "label": "Build Backend (Release)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/RemitMon.sln",
        "--configuration",
        "Release"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    }
  ]
}
