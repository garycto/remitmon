{
  "name": "RemitMon Development",
  "image": "mcr.microsoft.com/devcontainers/dotnet:1-8-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest"
    }
  },
  "services": {
    "postgres": {
      "image": "postgres:16-alpine",
      "environment": {
        "POSTGRES_DB": "remitmon",
        "POSTGRES_USER": "remitmon",
        "POSTGRES_PASSWORD": "remitmon_dev"
      },
      "ports": [5432],
      "volumes": [
        "postgres_data:/var/lib/postgresql/data"
      ]
    }
  },
  "volumes": {
    "postgres_data": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.vscode-dotnet-runtime",
        "ms-vscode-remote.remote-containers",
        "GitHub.Copilot",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "ms-mssql.sql-database-projects-vscode"
      ],
      "settings": {
        "dotnet.defaultSolutionOrFolder": "${workspaceFolder}",
        "[csharp]": {
          "editor.defaultFormatter": "ms-dotnettools.csharp",
          "editor.formatOnSave": true
        }
      }
    }
  },
  "postCreateCommand": "dotnet restore && npm install -C web",
  "remoteUser": "vscode"
}
